# No identity here on purpose: this repo is public, and a versioned [user]
# block means anyone who clones it commits as me until they notice.
#
# useConfigOnly makes git REFUSE to commit when no identity is configured,
# instead of silently inventing judoole@<hostname>.local. That turns a
# forgotten setup step into an immediate, obvious error.
[user]
	useConfigOnly = true

[init]
	defaultBranch = main

[core]
	excludesfile = ~/.config/git/ignore
	editor = vim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true

[diff]
	algorithm = histogram
	colorMoved = default
	renames = true

[merge]
	conflictstyle = zdiff3
	tool = vimdiff
[mergetool]
	keepBackup = false
[difftool]
	prompt = false

[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[pull]
	ff = only
[fetch]
	prune = true
	pruneTags = true

[rebase]
	autosquash = true
	autostash = true
[rerere]
	enabled = true
	autoupdate = true

[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[column]
	ui = auto

[help]
	autocorrect = 1
[credential]
	helper = osxkeychain
[color]
	ui = true

[alias]
	co = checkout
	sw = switch
	st = status -sb
	count = !git shortlog -sn
	last = log -1 HEAD --stat
	unstage = restore --staged
	amend = commit --amend --no-edit
	graph = log --graph --oneline --decorate --all
	# Branches you have merged and can safely delete.
	gone = "!git fetch -p && git branch -vv | awk '/: gone]/{print $1}'"

# --- identity layering ------------------------------------------------------
# Git applies includes in order and the last value wins, so these run from
# least to most specific:
#
#   1. ~/.gitconfig.local              your identity, never versioned
#   2. ~/.gitconfig.work               work identity, never versioned
#
# `make identity` creates ~/.gitconfig.local from git/gitconfig.local.example
# on a new machine. Until you fill it in, git refuses to commit (see
# user.useConfigOnly above) rather than guessing wrong.
#
# The work identity is selected by where the repo lives, not by which machine
# you are on, so a personal side project cloned onto the Autodesk Mac still
# commits as you. On that machine also copy git/gitconfig.work.example to
# ~/.gitconfig.work.

[include]
	path = ~/.gitconfig.local

[includeIf "gitdir:~/Code/autodesk/"]
	path = ~/.gitconfig.work
