[user]
	name = Ole Christian Langfjæran
	email = judoole@gmail.com

[init]
	defaultBranch = main

[core]
	excludesfile = ~/.config/git/ignore
	editor = vim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true

[diff]
	algorithm = histogram
	colorMoved = default
	renames = true

[merge]
	conflictstyle = zdiff3
	tool = vimdiff
[mergetool]
	keepBackup = false
[difftool]
	prompt = false

[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[pull]
	ff = only
[fetch]
	prune = true
	pruneTags = true

[rebase]
	autosquash = true
	autostash = true
[rerere]
	enabled = true
	autoupdate = true

[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[column]
	ui = auto

[help]
	autocorrect = 1
[credential]
	helper = osxkeychain
[color]
	ui = true

[alias]
	co = checkout
	sw = switch
	st = status -sb
	count = !git shortlog -sn
	last = log -1 HEAD --stat
	unstage = restore --staged
	amend = commit --amend --no-edit
	graph = log --graph --oneline --decorate --all
	# Branches you have merged and can safely delete.
	gone = "!git fetch -p && git branch -vv | awk '/: gone]/{print $1}'"

# --- identity layering ------------------------------------------------------
# Git applies includes in order and the last value wins, so these run from
# least to most specific:
#
#   1. the [user] block above          personal default, safe to publish
#   2. ~/.gitconfig.local              per-machine overrides, never versioned
#   3. ~/.gitconfig.work               work identity, never versioned
#
# The work identity is selected by where the repo lives, not by which machine
# you are on. That means a personal side project cloned onto the Autodesk Mac
# still commits as you, and the same versioned config is correct on every
# machine with no per-machine edit.
#
# On the work machine, copy git/gitconfig.work.example to ~/.gitconfig.work
# and fill in the Autodesk address. It is deliberately not in this repo — the
# repo is public.

[include]
	path = ~/.gitconfig.local

[includeIf "gitdir:~/Code/autodesk/"]
	path = ~/.gitconfig.work
