# Copy to ~/.gitconfig.work on the Autodesk machine. Never commit the real one.
#
#   cp git/gitconfig.work.example ~/.gitconfig.work
#
# Applies to every repo under ~/Code/autodesk/ (see the includeIf in
# .gitconfig). Repos anywhere else use ~/.gitconfig.local instead.
#
# The lines below are COMMENTED ON PURPOSE, so that an unedited copy leaves
# git refusing to commit rather than authoring with a placeholder address.

# [user]
# 	name = Your Name
# 	email = first.last@autodesk.com

# If Autodesk requires signed commits:
# [user]
# 	signingkey = <key id>
# [commit]
# 	gpgsign = true
