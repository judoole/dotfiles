# Template for ~/.gitconfig.local. `make identity` fills this in by prompting,
# substituting AUTHORNAME and AUTHOREMAIL. You can also copy it by hand.
#
# Never commit the filled-in version — this repo is public.
#
# Tip: GitHub can hide your real address. With "Keep my email address private"
# enabled in GitHub settings, enter your noreply address at the prompt, which
# looks like 12345+username@users.noreply.github.com

[user]
	name = AUTHORNAME
	email = AUTHOREMAIL
